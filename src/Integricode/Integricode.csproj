<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Integricode</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>integricode</ToolCommandName>
    <PackageId>Integricode</PackageId>
    <Version>1.0.0</Version>
    <Authors>GabrielBels</Authors>
    <Description>Reviews a pull request for bugs and against its linked REQ entry or Jira issue.</Description>
    <!-- GitHub Packages links the package to this repository, so its access follows the repository's. -->
    <RepositoryUrl>https://github.com/GabrielBels/integricode</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Anthropic" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Agent/ReviewInstructions.md" LogicalName="Integricode.Agent.ReviewInstructions.md" />
    <EmbeddedResource Include="Agent/Lenses/*.md" LogicalName="Integricode.Agent.Lenses.%(Filename).md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Integricode.Tests" />
  </ItemGroup>

</Project>
